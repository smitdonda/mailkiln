{
  "name": "mailkiln",
  "version": "0.1.0",
  "description": "Drag & drop email builder that ejects to real React Email code. Visual editor, HTML import/round-trip, deliverability linter, typed merge variables. No lock-in.",
  "keywords": [
    "email",
    "email-builder",
    "email-template",
    "drag-and-drop",
    "react-email",
    "mjml",
    "newsletter",
    "html-email",
    "editor",
    "deliverability"
  ],
  "license": "MIT",
  "author": "Smit Donda",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config examples/demo/vite.config.js",
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "vite build",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/style.css",
    "build:types": "tsc -p jsconfig.dts.json && node scripts/dts-cjs.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "npm run build && publint && npm run verify:attw",
    "verify:attw": "attw --pack . --ignore-rules no-resolution",
    "prepublishOnly": "npm run build",
    "verify:types": "tsc -p tests/types/jsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0"
  },
  "peerDependencies": {
    "linkedom": "^0.18.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "linkedom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^26.1.0",
    "linkedom": "^0.18.5",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smitdonda/mailkiln.git"
  },
  "bugs": {
    "url": "https://github.com/smitdonda/mailkiln/issues"
  },
  "homepage": "https://github.com/smitdonda/mailkiln#readme"
}
