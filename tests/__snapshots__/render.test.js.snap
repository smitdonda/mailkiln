            </Section>
            <Section style={{ padding: "12px 24px 12px 24px", textAlign: "center" }}>
              <Img
                src="https://example.com/hero.png"
                alt="Hero"
                width={552}
                style={{
                  display: "block",
                  width: "552px",
                  maxWidth: "100%",
                  height: "auto",
                  border: 0,
                }}
              />
            </Section>
            <Section style={{ padding: "12px 24px 12px 24px", textAlign: "center" }}>
              <Hr
                style={{ width: "100%", border: "none", borderTop: "1px solid #e5e7eb", margin: 0 }}
              />
            </Section>
            <div style={{ height: 32, lineHeight: "32px", fontSize: 0 }}>{'\\u00a0'}</div>
            <Section style={{ padding: "12px 24px 12px 24px", textAlign: "center" }}>
              <Section style={{ textAlign: "center" }}>
                <Link
                  href="https://twitter.com/"
                  style={{
                    display: "inline-block",
                    margin: "0 5px",
                    color: "#64748b",
                    fontSize: 13,
                    textDecoration: "underline",
                  }}
                >
                  Twitter
                </Link>
                <Link
                  href="https://instagram.com/"
                  style={{
                    display: "inline-block",
                    margin: "0 5px",
