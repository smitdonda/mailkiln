            </Section>
            <Section style={{ padding: "12px 24px 12px 24px", textAlign: "center" }}>
              <Section style={{ textAlign: "center" }}>
                <Link href="https://youtube.com/watch?v=abc">
                  <Img
                    src="https://example.com/thumb.jpg"
                    alt="Watch the video"
                    style={{
                      display: "block",
